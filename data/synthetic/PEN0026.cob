*> ********************************************************
*> PROGRAM : PEN0026
*> PURPOSE : PENALTY ASSESSMENT RULES
*> AUTHOR  : D.P.
*> CHANGE LOG:
*>   1989-02-18 ORIGINAL VERSION
*>   2003-12-03 THRESHOLDS UPDATED PER AUDIT REQ 718
*> RUN FROM JCL JOB PENNIGHT STEP070
*> ********************************************************
IDENTIFICATION DIVISION.
PROGRAM-ID. PEN0026.
ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
SOURCE-COMPUTER. IBM-370.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT.
    COPY PEN0026C REPLACING ==:PFX:== BY ==TX==.
01 RESULT-AREA.
    *> PENALTY WAIVER FLAG
    05 PEN-WAIVE-FLG      PIC X VALUE 'N'.
    *> LATE PAYMENT PENALTY
    05 LATE-CHARGE        PIC 9(5)V99 VALUE ZERO.
PROCEDURE DIVISION.
MAIN-PARA.
    ACCEPT WS-INPUT
    PERFORM WAIVE-PENALTY
    DISPLAY "PEN-WAIVE-FLG=" PEN-WAIVE-FLG
    DISPLAY "LATE-CHARGE=" LATE-CHARGE
    STOP RUN.
WAIVE-PENALTY.
    IF TX-FIRST-OFFENSE = 'Y'
        EVALUATE TRUE
            WHEN TX-CUSTOMER-TIER = 'G' OR TX-CUSTOMER-TIER = 'P'
                MOVE 'Y' TO PEN-WAIVE-FLG
                MOVE 0 TO LATE-CHARGE
            WHEN TX-DPD-DAYS <= 7
                MOVE 'Y' TO PEN-WAIVE-FLG
                MOVE 0 TO LATE-CHARGE
        END-EVALUATE
    END-IF.
