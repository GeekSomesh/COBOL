{
  "program": "SAM1",
  "program_file": "SAM1.cbl",
  "source": "data/public/ibm-zopeneditor-sample/SAM1.cbl",
  "status": "draft",
  "verified": false,
  "drafted_by": "Claude (Opus 5.5), by reading the COBOL source and docs/parser_subset.md, without looking at the parser's output",
  "note": "Expected rules under the documented slicing conventions (I/O-only branches and AT END handlers are not rules). Not reviewed by a COBOL expert: treat scores against this file as indicative, not as ground truth.",
  "revisions": [
    "2026-10-15: none to the rules. The first scoring run reported 3 action mismatches that were the parser writing ADD +1 TO X as 'X + +1'; fixed in the parser and in expression canonicalisation (unary plus)."
  ],
  "format": "see SAM2.json",
  "rules": [
    {"paragraph": "100-PROCESS-TRANSACTIONS", "lines": [264, 290], "title": "Count each transaction and remember its key",
     "when": ["!=", "WS-TRAN-EOF", "Y"],
     "then": [["compute", "NUM-TRAN-RECS", "NUM-TRAN-RECS + 1"], ["set", "WS-TRAN-OK", "Y"],
              ["move", "WS-PREV-TRAN-KEY", "TRAN-KEY"]]},
    {"paragraph": "100-PROCESS-TRANSACTIONS", "lines": [267, 270], "title": "Reject out-of-sequence transactions",
     "when": ["all", ["!=", "WS-TRAN-EOF", "Y"], ["<", "TRAN-KEY", {"ref": "WS-PREV-TRAN-KEY"}],
              ["!=", "TRAN-COMMENT", "*"]],
     "then": [["set", "ERR-MSG-DATA1", "TRANSACTION OUT OF SEQUENCE"], ["set", "ERR-MSG-DATA2", " "],
              ["perform", "299-REPORT-BAD-TRAN"]]},
    {"paragraph": "100-PROCESS-TRANSACTIONS", "lines": [273, 274], "title": "Route UPDATE transactions",
     "when": ["all", ["!=", "WS-TRAN-EOF", "Y"],
              ["not", ["all", ["<", "TRAN-KEY", {"ref": "WS-PREV-TRAN-KEY"}], ["!=", "TRAN-COMMENT", "*"]]],
              ["==", "TRAN-CODE", "UPDATE"]],
     "then": [["perform", "200-PROCESS-UPDATE-TRAN"]]},
    {"paragraph": "100-PROCESS-TRANSACTIONS", "lines": [275, 276], "title": "Route ADD transactions",
     "when": ["all", ["!=", "WS-TRAN-EOF", "Y"],
              ["not", ["all", ["<", "TRAN-KEY", {"ref": "WS-PREV-TRAN-KEY"}], ["!=", "TRAN-COMMENT", "*"]]],
              ["!=", "TRAN-CODE", "UPDATE"], ["==", "TRAN-CODE", "ADD"]],
     "then": [["perform", "210-PROCESS-ADD-TRAN"]]},
    {"paragraph": "100-PROCESS-TRANSACTIONS", "lines": [277, 278], "title": "Route DELETE transactions",
     "when": ["all", ["!=", "WS-TRAN-EOF", "Y"],
              ["not", ["all", ["<", "TRAN-KEY", {"ref": "WS-PREV-TRAN-KEY"}], ["!=", "TRAN-COMMENT", "*"]]],
              ["!=", "TRAN-CODE", "UPDATE"], ["!=", "TRAN-CODE", "ADD"], ["==", "TRAN-CODE", "DELETE"]],
     "then": [["perform", "220-PROCESS-DELETE-TRAN"]]},
    {"paragraph": "100-PROCESS-TRANSACTIONS", "lines": [280, 283], "title": "Reject unknown transaction codes (comments excepted)",
     "when": ["all", ["!=", "WS-TRAN-EOF", "Y"],
              ["not", ["all", ["<", "TRAN-KEY", {"ref": "WS-PREV-TRAN-KEY"}], ["!=", "TRAN-COMMENT", "*"]]],
              ["!=", "TRAN-CODE", "UPDATE"], ["!=", "TRAN-CODE", "ADD"], ["!=", "TRAN-CODE", "DELETE"],
              ["!=", "TRAN-COMMENT", "*"]],
     "then": [["set", "ERR-MSG-DATA1", "INVALID TRAN CODE:"], ["move", "ERR-MSG-DATA2", "TRAN-CODE"],
              ["perform", "299-REPORT-BAD-TRAN"]]},
    {"paragraph": "100-PROCESS-TRANSACTIONS", "lines": [288, 289], "title": "Report processed transactions",
     "when": ["all", ["!=", "WS-TRAN-EOF", "Y"], ["==", "WS-TRAN-OK", "Y"]],
     "then": [["perform", "830-REPORT-TRAN-PROCESSED"]]},

    {"paragraph": "200-PROCESS-UPDATE-TRAN", "lines": [296, 299], "title": "Update needs an existing customer",
     "when": ["any", ["!=", "CUST-KEY", {"ref": "TRAN-KEY"}], ["==", "WS-CUST-FILE-EOF", "Y"]],
     "then": [["set", "ERR-MSG-DATA1", "NO MATCHING KEY:"], ["move", "ERR-MSG-DATA2", "TRAN-KEY"],
              ["perform", "299-REPORT-BAD-TRAN"]]},
    {"paragraph": "200-PROCESS-UPDATE-TRAN", "lines": [300, 312], "title": "Apply the update through SAM2",
     "when": ["not", ["any", ["!=", "CUST-KEY", {"ref": "TRAN-KEY"}], ["==", "WS-CUST-FILE-EOF", "Y"]]],
     "then": [["call", "SAM2"]]},
    {"paragraph": "200-PROCESS-UPDATE-TRAN", "lines": [306, 309], "title": "Report updates SAM2 rejected",
     "when": ["all", ["not", ["any", ["!=", "CUST-KEY", {"ref": "TRAN-KEY"}], ["==", "WS-CUST-FILE-EOF", "Y"]]],
              ["!=", "WS-TRAN-OK", "Y"]],
     "then": [["move", "ERR-MSG-DATA1", "WS-TRAN-MSG"], ["set", "ERR-MSG-DATA2", " "],
              ["perform", "299-REPORT-BAD-TRAN"]]},
    {"paragraph": "200-PROCESS-UPDATE-TRAN", "lines": [310, 311], "title": "Count processed updates",
     "when": ["all", ["not", ["any", ["!=", "CUST-KEY", {"ref": "TRAN-KEY"}], ["==", "WS-CUST-FILE-EOF", "Y"]]],
              ["==", "WS-TRAN-OK", "Y"]],
     "then": [["compute", "NUM-UPDATE-PROCESSED", "NUM-UPDATE-PROCESSED + 1"]]},

    {"paragraph": "210-PROCESS-ADD-TRAN", "lines": [318, 333], "title": "Add a new blank customer unless the key exists",
     "when": ["==", "CUST-KEY", {"ref": "TRAN-KEY"}],
     "then": [["set", "ERR-MSG-DATA1", "DUPLICATE KEY:"], ["move", "ERR-MSG-DATA2", "TRAN-KEY"],
              ["perform", "299-REPORT-BAD-TRAN"]],
     "else": [["set", "WS-CUST-REC", " "], ["move", "WS-CUST-KEY", "TRAN-KEY"], ["set", "WS-CUST-ACCT-BALANCE", 0],
              ["set", "WS-CUST-ORDERS-YTD", 0], ["set", "WS-CUST-MONTH(I)", 0],
              ["perform", "740-WRITE-CUSTOUT-FILE"], ["compute", "NUM-ADD-PROCESSED", "NUM-ADD-PROCESSED + 1"]]},
    {"paragraph": "220-PROCESS-DELETE-TRAN", "lines": [338, 345], "title": "Delete only existing customers",
     "when": ["any", ["!=", "CUST-KEY", {"ref": "TRAN-KEY"}], ["==", "WS-CUST-FILE-EOF", "Y"]],
     "then": [["set", "ERR-MSG-DATA1", "NO MATCHING KEY:"], ["move", "ERR-MSG-DATA2", "TRAN-KEY"],
              ["perform", "299-REPORT-BAD-TRAN"]],
     "else": [["compute", "NUM-DELETE-PROCESSED", "NUM-DELETE-PROCESSED + 1"], ["perform", "730-READ-CUSTOMER-FILE"]]},

    {"paragraph": "700-OPEN-FILES", "lines": [361, 367], "title": "Stop when the customer input file fails to open",
     "when": ["!=", "WS-CUSTFILE-STATUS", "00"],
     "then": [["set", "RETURN-CODE", 16], ["set", "WS-TRAN-EOF", "Y"]]},
    {"paragraph": "700-OPEN-FILES", "lines": [368, 374], "title": "Stop when the customer output file fails to open",
     "when": ["!=", "WS-CUSTOUT-STATUS", "00"],
     "then": [["set", "RETURN-CODE", 16], ["set", "WS-TRAN-EOF", "Y"]]},
    {"paragraph": "700-OPEN-FILES", "lines": [375, 380], "title": "Stop when the transaction file fails to open",
     "when": ["!=", "WS-TRANFILE-STATUS", "00"],
     "then": [["set", "RETURN-CODE", 16], ["set", "WS-TRAN-EOF", "Y"]]},
    {"paragraph": "700-OPEN-FILES", "lines": [381, 386], "title": "Stop when the report file fails to open",
     "when": ["!=", "WS-REPORT-STATUS", "00"],
     "then": [["set", "RETURN-CODE", 16], ["set", "WS-TRAN-EOF", "Y"]]},

    {"paragraph": "710-READ-TRAN-FILE", "lines": [395, 396], "title": "Status 10 ends the transaction file",
     "when": ["all", ["!=", "WS-TRANFILE-STATUS", "00"], ["==", "WS-TRANFILE-STATUS", "10"]],
     "then": [["set", "WS-TRAN-EOF", "Y"]]},
    {"paragraph": "710-READ-TRAN-FILE", "lines": [397, 402], "title": "Other read errors are reported and end the run",
     "when": ["all", ["!=", "WS-TRANFILE-STATUS", "00"], ["!=", "WS-TRANFILE-STATUS", "10"]],
     "then": [["set", "ERR-MSG-DATA1", "Error on tran file read.  Code:"], ["move", "ERR-MSG-DATA2", "WS-CUSTFILE-STATUS"],
              ["perform", "299-REPORT-BAD-TRAN"], ["set", "WS-TRAN-EOF", "Y"]]},
    {"paragraph": "710-READ-TRAN-FILE", "lines": [404, 407], "title": "At end of transactions copy the remaining customers",
     "when": ["==", "WS-TRAN-EOF", "Y"],
     "then": [["perform", "721-COPY-RECORDS"]]},

    {"paragraph": "720-POSITION-CUST-FILE", "lines": [411, 415], "title": "Skip forward to the transaction's customer",
     "when": ["all", ["<", "CUST-KEY", {"ref": "TRAN-KEY"}], ["!=", "WS-CUST-FILE-EOF", "Y"]],
     "then": [["perform", "721-COPY-RECORDS"]]},

    {"paragraph": "730-READ-CUSTOMER-FILE", "lines": [431, 432], "title": "Status 10 ends the customer file",
     "when": ["all", ["not", ["any", ["==", "WS-CUSTFILE-STATUS", "00"], ["==", "WS-CUSTFILE-STATUS", "04"]]],
              ["==", "WS-CUSTFILE-STATUS", "10"]],
     "then": [["set", "WS-CUST-FILE-EOF", "Y"]]},
    {"paragraph": "730-READ-CUSTOMER-FILE", "lines": [433, 437], "title": "Report customer file read errors",
     "when": ["all", ["not", ["any", ["==", "WS-CUSTFILE-STATUS", "00"], ["==", "WS-CUSTFILE-STATUS", "04"]]],
              ["!=", "WS-CUSTFILE-STATUS", "10"]],
     "then": [["set", "ERR-MSG-DATA1", "Customer input File I/O Error on Read.  RC:"],
              ["move", "ERR-MSG-DATA2", "WS-CUSTFILE-STATUS"], ["perform", "299-REPORT-BAD-TRAN"]]},

    {"paragraph": "740-WRITE-CUSTOUT-FILE", "lines": [441, 446], "title": "Contact records are written in contact layout",
     "when": ["==", "WS-CUST-REC-TYPE", "A"],
     "then": [],
     "else": [["move", "WS-CUST-CONTACT-REC", "WS-CUST-REC"]]},
    {"paragraph": "740-WRITE-CUSTOUT-FILE", "lines": [450, 454], "title": "Report customer file write errors",
     "when": ["!=", "WS-CUSTOUT-STATUS", "00"],
     "then": [["set", "ERR-MSG-DATA1", "CUSTOMER OUTPUT FILE I/O ERROR ON WRITE. RC:"],
              ["move", "ERR-MSG-DATA2", "WS-CUSTFILE-STATUS"], ["perform", "299-REPORT-BAD-TRAN"]]},

    {"paragraph": "830-REPORT-TRAN-PROCESSED", "lines": [473, 477], "title": "Comment lines get no 'processed' label",
     "when": ["==", "TRAN-COMMENT", "*"],
     "then": [["set", "RPT-TRAN-MSG1", " "]],
     "else": [["set", "RPT-TRAN-MSG1", "       Transaction processed:"]]}
  ]
}
