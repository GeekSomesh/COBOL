{
  "program": "SAM2",
  "program_file": "SAM2.cbl",
  "source": "data/public/ibm-zopeneditor-sample/SAM2.cbl",
  "status": "draft",
  "verified": false,
  "drafted_by": "Claude (Opus 5.5), by reading the COBOL source and docs/parser_subset.md, without looking at the parser's output",
  "note": "Expected rules under the documented slicing conventions. Not reviewed by a COBOL expert: treat scores against this file as indicative, not as ground truth.",
  "revisions": [
    "2026-10-15: G003 trace 65-67 -> 65-66. The draft included the END-IF line; the documented convention (parser_subset.md rule 2) ends a branch's trace at its last statement. Found by the first scoring run."
  ],
  "format": "when: [op, field, value | {ref: field}] | [all|any, ...] | [not, c] | [is_numeric, field]; actions: [set, field, value] | [move, field, from-field] | [compute, field, expr] | [perform, para] | [call, program]",
  "rules": [
    {"paragraph": "000-MAIN", "lines": [61, 62], "title": "CRUNCH requests run the CPU benchmark",
     "when": ["==", "TRAN-CODE", "CRUNCH"],
     "then": [["perform", "300-PROCESS-CPU-CRUNCH"]]},
    {"paragraph": "000-MAIN", "lines": [63, 67], "title": "Other requests are validated first",
     "when": ["not", ["==", "TRAN-CODE", "CRUNCH"]],
     "then": [["perform", "100-VALIDATE-TRAN"]]},
    {"paragraph": "000-MAIN", "lines": [65, 66], "title": "Valid requests are applied",
     "when": ["all", ["not", ["==", "TRAN-CODE", "CRUNCH"]], ["==", "TRAN-OK", "Y"]],
     "then": [["perform", "200-PROCESS-TRAN"]]},

    {"paragraph": "100-VALIDATE-TRAN", "lines": [76, 78], "title": "Only UPDATE requests are accepted",
     "when": ["not", ["==", "TRAN-CODE", "UPDATE"]],
     "then": [["set", "TRAN-OK", "N"], ["set", "TRAN-MSG", "REQUEST TYPE IS INVALID"]]},
    {"paragraph": "100-VALIDATE-TRAN", "lines": [81, 102], "title": "Numeric fields start as not negative",
     "when": ["any", ["==", "TRAN-FIELD-NAME", "BALANCE"], ["==", "TRAN-FIELD-NAME", "ORDERS"]],
     "then": [["set", "WS-UPDATE-NUM-NEG", "N"]]},
    {"paragraph": "100-VALIDATE-TRAN", "lines": [83, 84], "title": "Blank cents default to zero",
     "when": ["all", ["any", ["==", "TRAN-FIELD-NAME", "BALANCE"], ["==", "TRAN-FIELD-NAME", "ORDERS"]],
              ["not", ["is_numeric", "TRAN-UPDATE-NUM-HH"]]],
     "then": [["set", "TRAN-UPDATE-NUM-HH", 0]]},
    {"paragraph": "100-VALIDATE-TRAN", "lines": [87, 89], "title": "Leading minus marks a negative amount",
     "when": ["all", ["any", ["==", "TRAN-FIELD-NAME", "BALANCE"], ["==", "TRAN-FIELD-NAME", "ORDERS"]],
              ["==", "TRAN-UPDATE-NUMX1", "-"]],
     "then": [["set", "WS-UPDATE-NUM-NEG", "Y"], ["set", "TRAN-UPDATE-NUMX1", "0"]]},
    {"paragraph": "100-VALIDATE-TRAN", "lines": [91, 92], "title": "Leading plus is dropped",
     "when": ["all", ["any", ["==", "TRAN-FIELD-NAME", "BALANCE"], ["==", "TRAN-FIELD-NAME", "ORDERS"]],
              ["==", "TRAN-UPDATE-NUMX1", "+"]],
     "then": [["set", "TRAN-UPDATE-NUMX1", "0"]]},
    {"paragraph": "100-VALIDATE-TRAN", "lines": [94, 96], "title": "Reject non-numeric amounts",
     "when": ["all", ["any", ["==", "TRAN-FIELD-NAME", "BALANCE"], ["==", "TRAN-FIELD-NAME", "ORDERS"]],
              ["not", ["is_numeric", "TRAN-UPDATE-NUM"]]],
     "then": [["set", "TRAN-OK", "N"], ["set", "TRAN-MSG", "DATA IS NOT NUMERIC"]]},
    {"paragraph": "100-VALIDATE-TRAN", "lines": [97, 101], "title": "Take the numeric amount",
     "when": ["all", ["any", ["==", "TRAN-FIELD-NAME", "BALANCE"], ["==", "TRAN-FIELD-NAME", "ORDERS"]],
              ["is_numeric", "TRAN-UPDATE-NUM"]],
     "then": [["move", "WS-UPDATE-NUM", "TRAN-UPDATE-NUM"]]},
    {"paragraph": "100-VALIDATE-TRAN", "lines": [99, 100], "title": "Apply the minus sign",
     "when": ["all", ["any", ["==", "TRAN-FIELD-NAME", "BALANCE"], ["==", "TRAN-FIELD-NAME", "ORDERS"]],
              ["is_numeric", "TRAN-UPDATE-NUM"], ["==", "WS-UPDATE-NUM-NEG", "Y"]],
     "then": [["compute", "WS-UPDATE-NUM", "WS-UPDATE-NUM * -1"]]},
    {"paragraph": "100-VALIDATE-TRAN", "lines": [108, 110], "title": "Only REPLACE or ADD actions",
     "when": ["not", ["any", ["==", "TRAN-ACTION", "REPLACE"], ["==", "TRAN-ACTION", "ADD"]]],
     "then": [["set", "TRAN-OK", "N"], ["set", "TRAN-MSG", "INVALID ACTION CODE"]]},

    {"paragraph": "200-PROCESS-TRAN", "lines": [115, 117], "title": "Replace the customer name",
     "when": ["==", "TRAN-FIELD-NAME", "NAME"],
     "then": [["move", "CUST-NAME", "TRAN-UPDATE-DATA"], ["compute", "TRAN-COUNT", "TRAN-COUNT + 1"]]},
    {"paragraph": "200-PROCESS-TRAN", "lines": [120, 122], "title": "Replace the account balance",
     "when": ["all", ["not", ["==", "TRAN-FIELD-NAME", "NAME"]], ["==", "TRAN-FIELD-NAME", "BALANCE"],
              ["==", "TRAN-ACTION", "REPLACE"]],
     "then": [["move", "CUST-ACCT-BALANCE", "WS-UPDATE-NUM"], ["compute", "TRAN-COUNT", "TRAN-COUNT + 1"]]},
    {"paragraph": "200-PROCESS-TRAN", "lines": [123, 126], "title": "Add to the account balance",
     "when": ["all", ["not", ["==", "TRAN-FIELD-NAME", "NAME"]], ["==", "TRAN-FIELD-NAME", "BALANCE"],
              ["not", ["==", "TRAN-ACTION", "REPLACE"]], ["==", "TRAN-ACTION", "ADD"]],
     "then": [["compute", "CUST-ACCT-BALANCE", "CUST-ACCT-BALANCE + WS-UPDATE-NUM"],
              ["compute", "TRAN-COUNT", "TRAN-COUNT + 1"]]},
    {"paragraph": "200-PROCESS-TRAN", "lines": [130, 132], "title": "Replace year-to-date orders",
     "when": ["all", ["not", ["==", "TRAN-FIELD-NAME", "NAME"]], ["not", ["==", "TRAN-FIELD-NAME", "BALANCE"]],
              ["==", "TRAN-FIELD-NAME", "ORDERS"], ["==", "TRAN-ACTION", "REPLACE"]],
     "then": [["move", "CUST-ORDERS-YTD", "WS-UPDATE-NUM"], ["compute", "TRAN-COUNT", "TRAN-COUNT + 1"]]},
    {"paragraph": "200-PROCESS-TRAN", "lines": [133, 136], "title": "Add to year-to-date orders",
     "when": ["all", ["not", ["==", "TRAN-FIELD-NAME", "NAME"]], ["not", ["==", "TRAN-FIELD-NAME", "BALANCE"]],
              ["==", "TRAN-FIELD-NAME", "ORDERS"], ["not", ["==", "TRAN-ACTION", "REPLACE"]],
              ["==", "TRAN-ACTION", "ADD"]],
     "then": [["compute", "CUST-ORDERS-YTD", "CUST-ORDERS-YTD + WS-UPDATE-NUM"],
              ["compute", "TRAN-COUNT", "TRAN-COUNT + 1"]]},
    {"paragraph": "200-PROCESS-TRAN", "lines": [138, 140], "title": "Reject unknown field names",
     "when": ["all", ["not", ["==", "TRAN-FIELD-NAME", "NAME"]], ["not", ["==", "TRAN-FIELD-NAME", "BALANCE"]],
              ["not", ["==", "TRAN-FIELD-NAME", "ORDERS"]]],
     "then": [["set", "TRAN-OK", "N"], ["set", "TRAN-MSG", "FIELD NAME INVALID"]]},

    {"paragraph": "310-CRUNCH-LOOP", "lines": [153, 155], "title": "Non-numeric monthly figures count as zero",
     "when": ["not", ["is_numeric", "CUST-MONTH(MONTH-SUB)"]],
     "then": [["set", "CUST-MONTH(MONTH-SUB)", 0]]}
  ]
}
