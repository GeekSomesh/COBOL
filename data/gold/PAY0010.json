      "rule_id": "PAY0010-R002",
      "version": 1,
      "title": "Heavy overtime",
      "intent": "Add 30% of gross pay as overtime when more than 60 hours were worked.",
      "domain": "payroll_deductions",
      "conditions": {
        "all": [
          {
            "not": {
              "field": "employee_type",
              "source_name": "EMPLOYEE-TYPE",
              "op": "==",
              "value": "C"
            }
          },
          {
            "field": "hours_worked",
            "source_name": "HRS-WKD",
            "op": ">",
            "value": 60
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "overtime_pay",
          "source_name": "OT-AMOUNT",
          "expr": "PERIOD-GROSS * 0.30"
