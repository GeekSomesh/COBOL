      "version": 1,
      "title": "Senior saver bonus",
      "intent": "Add 0.25% to the base rate for customers aged 62 or over with at least 10,000 on deposit; everyone else gets the base rate.",
      "domain": "interest_tiers",
      "conditions": {
        "all": [
          {
            "field": "customer_age",
            "source_name": "TX-CUSTOMER-AGE",
            "op": ">=",
            "value": 62
          },
          {
            "field": "balance",
            "source_name": "TX-CURR-BAL",
            "op": ">=",
            "value": 10000
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "bonus_rate",
          "source_name": "BONUS-RATE",
          "expr": "TX-BASE-RATE + 0.0025"
        }
      ],
      "else_actions": [
        {
          "type": "set",
          "target": "bonus_rate",
          "source_name": "BONUS-RATE",
          "expr": "TX-BASE-RATE"
        }
      ],
