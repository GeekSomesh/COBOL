      "version": 1,
      "title": "Repeat late payer suspension",
      "intent": "Suspend the account and add a 100 penalty when a customer with 5 or more late payments in 12 months is over 30 days late.",
      "domain": "penalty_assessment",
      "conditions": {
        "all": [
          {
            "field": "late_count_12m",
            "source_name": "WS-LCNT",
            "op": ">=",
            "value": 5
          },
          {
            "field": "days_late",
            "source_name": "D-PD",
            "op": ">",
            "value": 30
          }
        ]
      },
      "actions": [
        {
          "type": "set",
          "target": "account_status",
          "source_name": "WS-AST",
          "value": "S"
        },
        {
          "type": "compute",
