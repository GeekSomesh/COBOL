    {
      "rule_id": "FEE0002-R001",
      "version": 1,
      "title": "Excess transaction fee",
      "intent": "Charge 0.25 for each transaction above 10 in the month.",
      "domain": "fee_exemptions",
      "conditions": {
        "all": [
          {
            "field": "txn_count_month",
            "source_name": "WS-MTC",
            "op": ">",
            "value": 10
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "excess_fee",
          "source_name": "WS-XFEE",
          "expr": "(WS-MTC - 10) * 0.25"
        }
      ],
