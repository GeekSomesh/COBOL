      "version": 1,
      "title": "Prime credit limit",
      "intent": "Set the credit limit to 25% of annual income for scores of 750 or more.",
      "domain": "credit_approval",
      "conditions": {
        "all": [
          {
            "field": "credit_score",
            "source_name": "CREDIT-SCORE",
            "op": ">=",
            "value": 750
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "credit_limit",
          "source_name": "CREDIT-LIMIT",
          "expr": "ANNUAL-INCOME * 0.25"
        }
