      "title": "Senior saver bonus",
      "intent": "Add 0.25% to the base rate for customers aged 65 or over with at least 25,000 on deposit; everyone else gets the base rate.",
      "domain": "interest_tiers",
      "conditions": {
        "all": [
          {
            "field": "customer_age",
            "source_name": "CUST-AGE",
            "op": ">=",
            "value": 65
          },
          {
            "field": "balance",
            "source_name": "ACCT-BALANCE",
            "op": ">=",
            "value": 25000
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "bonus_rate",
          "source_name": "FINAL-RATE",
          "expr": "BASE-RATE + 0.0025"
