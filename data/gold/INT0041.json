      "title": "Senior saver bonus",
      "intent": "Add 0.5% to the base rate for customers aged 55 or over with at least 5,000 on deposit; everyone else gets the base rate.",
      "domain": "interest_tiers",
      "conditions": {
        "all": [
          {
            "field": "customer_age",
            "source_name": "CA-AGE",
            "op": ">=",
            "value": 55
          },
          {
            "field": "balance",
            "source_name": "WS-BAL",
            "op": ">=",
            "value": 5000
          }
        ]
      },
