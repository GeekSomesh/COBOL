      "title": "Excess transaction fee",
      "intent": "Charge 0.25 for each transaction above 15 in the month.",
      "domain": "fee_exemptions",
      "conditions": {
        "all": [
          {
            "field": "txn_count_month",
            "source_name": "WS-MTC",
            "op": ">",
            "value": 15
          }
