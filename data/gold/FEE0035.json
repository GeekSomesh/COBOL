      "rule_id": "FEE0035-R001",
      "version": 1,
      "title": "Excess transaction fee",
      "intent": "Charge 0.50 for each transaction above 10 in the month.",
      "domain": "fee_exemptions",
      "conditions": {
        "all": [
          {
            "field": "txn_count_month",
            "source_name": "MONTHLY-TXNS",
            "op": ">",
            "value": 10
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "excess_fee",
          "source_name": "OVERLIMIT-FEE",
          "expr": "(MONTHLY-TXNS - 10) * 0.50"
        }
      ],
