      "conditions": {
        "all": [
          {
            "field": "late_count_12m",
            "source_name": "LATE-CNT-12M",
            "op": ">=",
            "value": 5
          },
          {
            "field": "days_late",
            "source_name": "DPD-DAYS",
            "op": ">",
            "value": 45
          }
        ]
      },
      "actions": [
        {
          "type": "set",
