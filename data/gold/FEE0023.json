      "version": 1,
      "title": "Excess transaction fee",
      "intent": "Charge 0.50 for each transaction above 10 in the month.",
      "domain": "fee_exemptions",
      "conditions": {
        "all": [
          {
            "field": "txn_count_month",
            "source_name": "TX-M-TX",
            "op": ">",
            "value": 10
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "excess_fee",
          "source_name": "WS-XFEE",
          "expr": "(TX-M-TX - 10) * 0.50"
        }
      ],
