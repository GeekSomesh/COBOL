      "rule_id": "PEN0003-R001",
      "version": 1,
      "title": "Repeat late payer suspension",
      "intent": "Suspend the account and add a 100 penalty when a customer with 3 or more late payments in 12 months is over 45 days late.",
      "domain": "penalty_assessment",
      "conditions": {
        "all": [
          {
            "field": "late_count_12m",
            "source_name": "L-PY",
            "op": ">=",
            "value": 3
          },
          {
            "field": "days_late",
            "source_name": "WS-DLT",
            "op": ">",
            "value": 45
          }
        ]
      },
      "actions": [
        {
          "type": "set",
          "target": "account_status",
          "source_name": "AS-CD",
          "value": "S"
        },
        {
          "type": "compute",
          "target": "penalty_amt",
          "source_name": "PA-AMT",
          "expr": "PA-AMT + 100"
        }
      ],
