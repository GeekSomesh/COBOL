      "version": 1,
      "title": "Repeat late payer suspension",
      "intent": "Suspend the account and add a 100 penalty when a customer with 4 or more late payments in 12 months is over 45 days late.",
      "domain": "penalty_assessment",
      "conditions": {
        "all": [
          {
            "field": "late_count_12m",
            "source_name": "LATE-PMTS-YR",
            "op": ">=",
            "value": 4
          },
          {
            "field": "days_late",
            "source_name": "DPD-DAYS",
            "op": ">",
            "value": 45
          }
        ]
      },
      "actions": [
        {
          "type": "set",
          "target": "account_status",
          "source_name": "ACCOUNT-STAT",
          "value": "S"
