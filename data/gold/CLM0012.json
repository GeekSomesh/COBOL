      "version": 1,
      "title": "Medical co-insurance",
      "intent": "Pay 90% of medical claims.",
      "domain": "insurance_claims",
      "conditions": {
        "all": [
          {
            "field": "claim_type",
            "source_name": "LOSS-TYPE",
            "op": "==",
            "value": "M"
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "payout_amt",
          "source_name": "PAYOUT-AMT",
          "expr": "CLM-AMOUNT * 0.90"
