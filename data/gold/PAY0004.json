      "rule_id": "PAY0004-R002",
      "version": 1,
      "title": "Heavy overtime",
      "intent": "Add 25% of gross pay as overtime when more than 60 hours were worked.",
      "domain": "payroll_deductions",
      "conditions": {
        "all": [
          {
            "not": {
              "field": "employee_type",
              "source_name": "EMP-TYPE",
              "op": "==",
              "value": "C"
            }
          },
          {
            "field": "hours_worked",
            "source_name": "HRS-WKD",
            "op": ">",
            "value": 60
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "overtime_pay",
          "source_name": "OVERTIME-PAY",
          "expr": "GROSS-PAY * 0.25"
