      "version": 1,
      "title": "Excess transaction fee",
      "intent": "Charge 0.25 for each transaction above 25 in the month.",
      "domain": "fee_exemptions",
      "conditions": {
        "all": [
          {
            "field": "txn_count_month",
            "source_name": "MTH-TRAN-CNT",
            "op": ">",
            "value": 25
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "excess_fee",
          "source_name": "EXTRA-TXN-FEE",
          "expr": "(MTH-TRAN-CNT - 25) * 0.25"
        }
      ],
