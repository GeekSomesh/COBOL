      "title": "Prime credit limit",
      "intent": "Set the credit limit to 30% of annual income for scores of 740 or more.",
      "domain": "credit_approval",
      "conditions": {
        "all": [
          {
            "field": "credit_score",
            "source_name": "WS-CSCR",
            "op": ">=",
            "value": 740
          }
        ]
      },
      "actions": [
