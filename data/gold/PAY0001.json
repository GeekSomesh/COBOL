      "rule_id": "PAY0001-R002",
      "version": 1,
      "title": "Heavy overtime",
      "intent": "Add 25% of gross pay as overtime when more than 50 hours were worked.",
      "domain": "payroll_deductions",
      "conditions": {
        "all": [
          {
            "not": {
              "field": "employee_type",
              "source_name": "ET-CD",
              "op": "==",
              "value": "C"
            }
          },
          {
            "field": "hours_worked",
            "source_name": "HW-HH",
            "op": ">",
            "value": 50
          }
        ]
      },
      "actions": [
        {
          "type": "compute",
          "target": "overtime_pay",
          "source_name": "O-PY",
          "expr": "P-GR * 0.25"
