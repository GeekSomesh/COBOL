    {
      "rule_id": "PEN0021-R001",
      "version": 1,
      "title": "Repeat late payer suspension",
      "intent": "Suspend the account and add a 100 penalty when a customer with 4 or more late payments in 12 months is over 30 days late.",
      "domain": "penalty_assessment",
      "conditions": {
        "all": [
          {
            "field": "late_count_12m",
            "source_name": "LC-12",
            "op": ">=",
            "value": 4
          },
          {
            "field": "days_late",
            "source_name": "DL-DD",
            "op": ">",
            "value": 30
          }
        ]
      },
      "actions": [
        {
          "type": "set",
          "target": "account_status",
          "source_name": "A-SC",
          "value": "S"
        },
        {
          "type": "compute",
          "target": "penalty_amt",
          "source_name": "WS-PEN",
          "expr": "WS-PEN + 100"
        }
      ],
