      "version": 1,
      "title": "Medical co-insurance",
      "intent": "Pay 80% of medical claims.",
      "domain": "insurance_claims",
      "conditions": {
        "all": [
          {
            "field": "claim_type",
            "source_name": "CLM-TYPE-CD",
            "op": "==",
