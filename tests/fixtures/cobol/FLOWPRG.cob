IDENTIFICATION DIVISION.
PROGRAM-ID. FLOWPRG.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-IN.
   05 CUST-AGE        PIC 9(3).
   05 ACCT-YEARS      PIC 9(2).
   05 INCOME          PIC 9(7).
   05 TXN-AMT         PIC 9(5).
   05 TXN-FEE         PIC 9(3).
01 WS-WORK.
   05 WS-SCORE        PIC 9(4) VALUE 0.
   05 WS-I            PIC 9(2) VALUE 0.
01 WS-OUT.
   05 WS-VALID        PIC X VALUE 'N'.
   05 DECISION        PIC X VALUE ' '.
   05 HIGH-FLAG       PIC X VALUE 'N'.
   05 WS-COUNT        PIC 9(2) VALUE 0.
PROCEDURE DIVISION.
MAIN-PARA.
    ACCEPT WS-IN
    PERFORM INIT-WORK
    PERFORM CHECK-INPUT THRU CHECK-INPUT-EXIT
    IF WS-VALID = 'Y'
        PERFORM SCORING
    ELSE
        MOVE 'R' TO DECISION
    END-IF
    PERFORM COUNT-STEP VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 3
    DISPLAY "WS-VALID=" WS-VALID
    DISPLAY "DECISION=" DECISION
    DISPLAY "HIGH-FLAG=" HIGH-FLAG
    DISPLAY "WS-COUNT=" WS-COUNT
    DISPLAY "WS-SCORE=" WS-SCORE
    STOP RUN.
INIT-WORK.
    COMPUTE WS-SCORE = CUST-AGE * 2 + ACCT-YEARS.
CHECK-INPUT.
    IF CUST-AGE < 18
        MOVE 'N' TO WS-VALID
        GO TO CHECK-INPUT-EXIT
    END-IF
    IF INCOME = ZERO
        MOVE 'N' TO WS-VALID
        GO TO CHECK-INPUT-EXIT
    END-IF
    MOVE 'Y' TO WS-VALID.
CHECK-INPUT-EXIT.
    EXIT.
COUNT-STEP.
    ADD 1 TO WS-COUNT.
DEAD-CODE.
    IF CUST-AGE > 100
        MOVE 'X' TO DECISION
    END-IF.
SCORING SECTION.
SCORE-DECIDE.
    IF WS-SCORE > 100
        MOVE 'A' TO DECISION
    ELSE
        MOVE 'C' TO DECISION
    END-IF.
SCORE-AMOUNT.
    IF TXN-AMT + TXN-FEE > 5000
        MOVE 'Y' TO HIGH-FLAG
    END-IF.
